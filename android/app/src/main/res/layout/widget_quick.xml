<?xml version="1.0" encoding="utf-8"?>
<!-- KeySpace Quick Widget (2×1) — shortcut langsung ke Chat AI -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_card_yellow"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:id="@+id/widget_quick_root">

    <!-- Logo / Icon -->
    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="KeySpace" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp">

        <TextView
            android:id="@+id/widget_quick_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CHAT AI"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#111111"
            android:letterSpacing="0.08"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ketuk untuk mulai &gt;"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#88111111"
            android:layout_marginTop="1dp" />

    </LinearLayout>

</LinearLayout>
